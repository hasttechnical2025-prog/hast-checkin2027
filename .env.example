# Sao chép file này thành .env.local rồi điền key THẬT từ Supabase (Settings -> API).
# .env.local ĐÃ bị .gitignore — không commit. KHÔNG dán key vào chat/README.

# Công khai (an toàn cho client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# BÍ MẬT — CHỈ dùng ở server (Route Handler / Server Action).
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ cho key này.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
