# Sao chép file này thành .env.local rồi điền key THẬT.
# .env.local ĐÃ bị .gitignore — không commit. KHÔNG dán key vào chat/README.
# Trên Vercel: khai cùng 6 biến này ở Settings -> Environment Variables (Production + Preview).

# ── Công khai (an toàn cho client, có tiền tố NEXT_PUBLIC_) ──
# Supabase -> Settings -> API -> Project URL / anon public
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# ── BÍ MẬT — CHỈ dùng ở server (Route Handler / Server Action) ──
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ cho các key dưới đây.

# Supabase -> Settings -> API -> service_role (toàn quyền DB, bỏ qua RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# Token bot Telegram (từ @BotFather) — gửi thông báo chấm công / nhắc nhở
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Chuỗi bí mật tự đặt để xác thực cron nhắc nhở của Vercel.
# Vercel tự gắn "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron/*.
# Tạo chuỗi ngẫu nhiên, ví dụ: openssl rand -hex 32
CRON_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Chuỗi bí mật tự đặt để xác thực webhook đồng bộ nghỉ phép (/api/sync/nghi-phep).
# Hệ thống gọi tới phải gửi đúng secret này. Tạo ngẫu nhiên như trên.
SYNC_SECRET=doi-thanh-chuoi-ngau-nhien-dai
